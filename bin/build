<?php

/**
 * Installer Toolkit - Build Command
 *
 * Generates a /package folder for any Laravel project from a shared template.
 * Each project only needs a package-config.php in its root.
 *
 * Usage:
 *   php ~/php/installer-toolkit/bin/build                    # Run from project root
 *   php ~/php/installer-toolkit/bin/build /path/to/project   # Or specify path
 */

$toolkitDir = dirname(__DIR__);
$projectDir = isset($argv[1]) ? $argv[1] : getcwd();

if (! is_dir($projectDir)) {
    echo "Error: Project directory not found: {$projectDir}\n";
    exit(1);
}

$configFile = $projectDir.'/package/package-config.php';
if (! file_exists($configFile)) {
    echo "Error: No package-config.php found in {$projectDir}/package/\n";
    echo "Create one using this format:\n\n";
    echo "  return [\n";
    echo "      'name'              => 'Your App Name',\n";
    echo "      'slug'              => 'your-app',\n";
    echo "      'min_php_version'   => '8.3.0',\n";
    echo "      'essential_seeders' => [...],\n";
    echo "      'sample_seeders'    => [...],\n";
    echo "  ];\n\n";
    exit(1);
}

$config = require $configFile;

$required = ['name', 'slug', 'min_php_version'];
foreach ($required as $key) {
    if (empty($config[$key])) {
        echo "Error: Missing required config key: {$key}\n";
        exit(1);
    }
}

$slug = $config['slug'];
$zipFilename = $config['slug'].'.zip';
$packageDir = $projectDir.'/package';
$packagesDir = $packageDir.'/packages';

echo "Building package for: {$config['name']}\n";
echo "Output: {$packageDir}\n\n";

// ─── Create directory structure ───────────────────────────────────────────────
if (! is_dir($packagesDir)) {
    mkdir($packagesDir, 0755, true);
    echo "  Created directory structure\n";
}

// ─── 1. Generate install.php ──────────────────────────────────────────────────
echo "  Generating install.php...";
$template = file_get_contents($toolkitDir.'/templates/install.php');

$installerVersion = trim(file_get_contents($toolkitDir.'/VERSION'));

$configBlock = implode("\n", [
    "define('ZIP_FILENAME', '{$zipFilename}');",
    "define('APP_FOLDER', '{$slug}');",
    "define('MIN_PHP_VERSION', '{$config['min_php_version']}');",
    "define('INSTALLER_VERSION', '{$installerVersion}');",
]);

$template = preg_replace(
    '/\/\/ \[\[INSTALLER_CONFIG\]\].*?\/\/ \[\[\/INSTALLER_CONFIG\]\]/s',
    $configBlock,
    $template
);

$essentialSeeders = $config['essential_seeders'] ?? [];
$sampleSeeders = $config['sample_seeders'] ?? [];

$essentialArray = buildSeederArray($essentialSeeders);
$sampleArray = buildSeederArray($sampleSeeders);

$template = preg_replace(
    '/private const ESSENTIAL_SEED_CLASSES = \[.*?\];/s',
    "private const ESSENTIAL_SEED_CLASSES = {$essentialArray};",
    $template
);

$template = preg_replace(
    '/private const SAMPLE_SEED_CLASSES = \[.*?\];/s',
    "private const SAMPLE_SEED_CLASSES = {$sampleArray};",
    $template
);

file_put_contents($packageDir.'/install.php', $template);
echo " done\n";

// ─── 2. Copy scanner.php ──────────────────────────────────────────────────────
echo "  Copying scanner.php...";
copy($toolkitDir.'/templates/scanner.php', $packageDir.'/scanner.php');
echo " done\n";

// ─── 3. Copy readme.md ──────────────────────────────────────────────────────
echo "  Copying readme.md...";
copy($toolkitDir.'/readme.md', $packageDir.'/readme.md');
echo " done\n";

// ─── 4. Generate release-workflow.md ──────────────────────────────────────────
echo "  Generating release-workflow.md...";
$workflow = generateReleaseWorkflow($config);
file_put_contents($packageDir.'/release-workflow.md', $workflow);
echo " done\n";

// ─── 5. Generate CHANGES.md (if not exists) ──────────────────────────────────
if (! file_exists($packageDir.'/CHANGES.md')) {
    echo "  Creating initial CHANGES.md...";
    $changes = "# {$config['name']} - Changelog\n\n";
    $changes .= "## 1.0.0 - Initial Release\n\n";
    $changes .= "- Initial release\n";
    file_put_contents($packageDir.'/CHANGES.md', $changes);
    echo " done\n";
} else {
    echo "  CHANGES.md already exists, skipping\n";
}

// ─── 6. Generate packages/.gitignore ──────────────────────────────────────────
echo "  Generating packages/.gitignore...";
file_put_contents($packagesDir.'/.gitignore', "*.zip\n*.update\n");
echo " done\n";

echo "\n\033[32m✔ Package built successfully for {$config['name']}\033[0m\n";
echo "  Files generated in: {$packageDir}\n\n";
echo "Next steps:\n";
echo "  1. Run 'php {$packageDir}/scanner.php' to verify dependencies\n";
echo "  2. Run 'php artisan package:build' to create the distributable zip\n";
echo "  3. Copy install.php + the zip to your distribution channel\n";

function buildSeederArray(array $seeders): string
{
    if (empty($seeders)) {
        return '[]';
    }

    $lines = "[\n";
    foreach ($seeders as $seeder) {
        $lines .= "        '{$seeder}',\n";
    }
    $lines .= '    ]';

    return $lines;
}

function generateReleaseWorkflow(array $config): string
{
    $name = $config['name'];
    $slug = $config['slug'];
    $phpVersion = str_replace('.0', '', $config['min_php_version']);

    return <<<MD
# Release Workflow

This document describes how to version and release {$name} distributable packages.

## Semantic Versioning (SemVer)

This project follows [Semantic Versioning](https://semver.org). Version numbers use the format **MAJOR.MINOR.PATCH**:

| Component | When to bump | Example |
|-----------|-------------|---------|
| **MAJOR** | Breaking changes that require customers to take action (e.g., new PHP version requirement, database schema changes that aren't auto-migrated, removed features) | 1.0.0 → **2.0.0** |
| **MINOR** | New features that are backwards compatible (e.g., new admin page, new feature) | 1.2.0 → **1.3.0** |
| **PATCH** | Bug fixes and small improvements that don't add features | 1.2.0 → **1.2.1** |

## Where the Version Lives

The single source of truth is in `config/app.php`:

```php
'version' => '1.0.0',
```

This is accessible anywhere in the application via `config('app.version')`.

> **Note:** The `INSTALLER_VERSION` in `package/install.php` is separate — it tracks the web installer's own version, not the application version.

## Release Checklist

Follow these steps for every release:

### 1. Bump the Version

Edit `config/app.php` and update the `'version'` value:

```php
'version' => '1.1.0',  // was '1.0.0'
```

### 2. Update the Changelog

Add a new section at the top of `package/CHANGES.md`:

```markdown
## 1.1.0 Short Description

- Added feature X
- Improved Y
- Fixed bug Z
```

### 3. Commit the Version Bump

```bash
git add config/app.php package/CHANGES.md
git commit -m "chore: bump version to 1.1.0"
```

### 4. Build the Package

```bash
php artisan package:build
```

This produces `package/packages/{$slug}-v1.1.0-full.zip`.

### 5. Create a Git Tag

A Git tag is a permanent bookmark pointing to a specific commit. It marks exactly which code shipped in a version.

```bash
git tag v1.1.0
```

### 6. Push to GitHub

```bash
git push origin main --tags
```

## Useful Git Tag Commands

```bash
# List all tags
git tag

# List tags matching a pattern
git tag -l "v1.*"

# Show details about a specific tag
git show v1.0.0

# Delete a local tag (if you made a mistake)
git tag -d v1.0.0

# Delete a remote tag (if you pushed it by mistake)
git push origin --delete v1.0.0

# Check out the code at a specific version
git checkout v1.0.0
```

## Quick Reference

```
Version bump → Changelog → Commit → Build → Tag → Push
```
MD;
}

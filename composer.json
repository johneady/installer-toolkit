{
    "name": "johneady/installer-toolkit",
    "type": "library",
    "description": "Shared installer wizard, self-update engine, and package:build command for Laravel apps distributed as self-installing zips.",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-sodium": "*",
        "ext-zip": "*",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "symfony/process": "^6.0|^7.0"
    },
    "autoload": {
        "psr-4": {
            "InstallerToolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InstallerToolkit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InstallerToolkit\\Update\\UpdateServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "pestphp/pest": "^4.1",
        "orchestra/testbench": "^10.0",
        "laravel/pint": "^1.29"
    },
    "scripts": {
        "test": "pest",
        "pint": "pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
